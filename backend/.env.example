# Fundação do backend PrazoAI — exemplo de ambiente (sem segredos).
SERVICE_NAME=prazoai-backend
ENVIRONMENT=development
API_PREFIX=/api
API_VERSION_PREFIX=/v1
# Alias legado /api/health (contrato canônico é /api/v1/health)
ENABLE_LEGACY_HEALTH_ALIAS=true
# Origens permitidas para CORS (separadas por vírgula). Em produção, liste origens
# explícitas; NÃO use "*" (é descartado porque allow_credentials=True).
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
