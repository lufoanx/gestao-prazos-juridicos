# Fundação do backend PrazoAI — exemplo de ambiente (sem segredos).
SERVICE_NAME=prazoai-backend
ENVIRONMENT=development
API_PREFIX=/api
API_VERSION_PREFIX=/v1
# Alias legado /api/health (contrato canônico é /api/v1/health)
ENABLE_LEGACY_HEALTH_ALIAS=true
# Origens permitidas para CORS (separadas por vírgula). Em produção, liste origens
# explícitas; NÃO use "*" (é descartado porque allow_credentials=True).
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Autenticação (Etapa 2 — armazenamento EM MEMÓRIA, sem banco) ---
# ATENÇÃO: usuários e sessões ficam só na memória do processo: são perdidos ao reiniciar
# e não funcionam com múltiplos workers. Bloqueado em ENVIRONMENT=production.
AUTH_ENABLED=true
AUTH_STORAGE=memory
# Segredo de assinatura dos access tokens (HS256), mínimo 32 bytes. NUNCA versione o valor real.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Vazio em development/test = segredo aleatório efêmero por instância (tokens caem ao reiniciar).
# Obrigatório em staging/production.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=prazoai-backend
AUTH_JWT_AUDIENCE=prazoai-api
# Validades em segundos (access: 60–3600; sessão/refresh: 3600–2592000; recuperação: 300–86400)
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
# Limites básicos (em memória, por processo)
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_FORGOT_MAX_REQUESTS=3
AUTH_FORGOT_WINDOW_SECONDS=900
# Cadastro e redefinição: limitados por IP antes de qualquer cálculo de Argon2
AUTH_REGISTER_MAX_REQUESTS=10
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_RESET_MAX_REQUESTS=10
AUTH_RESET_WINDOW_SECONDS=900
# Teto de chaves rastreadas por limitador (excedente compartilha um balde de transbordo)
AUTH_RATE_LIMIT_MAX_KEYS=10000
# Sessões simultâneas por usuário (as mais antigas são removidas ao exceder)
AUTH_MAX_SESSIONS_PER_USER=10
# Rotações de refresh por sessão (10–100000). Ao atingir o teto, o próximo refresh encerra
# a sessão (401 session_rotation_limit_reached) e o cliente deve fazer novo login.
AUTH_MAX_REFRESH_ROTATIONS_PER_SESSION=1000
