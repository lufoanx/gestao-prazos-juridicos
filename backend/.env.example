# Fundação do backend PrazoAI — exemplo de ambiente (sem segredos).
SERVICE_NAME=prazoai-backend
# development | test | staging (homologação) | production. staging/production só iniciam com TODOS os
# requisitos de implantação (STORAGE=postgres com sslmode, segredos, PUBLIC_APP_ORIGIN https, CORS restrito,
# TRUSTED_PROXY_SECRET, SMTP autenticado com TLS, LOG_LEVEL≠DEBUG, um worker) — doc 27. Nunca hospede
# contas reais em development/test.
ENVIRONMENT=development
API_PREFIX=/api
API_VERSION_PREFIX=/v1
# Alias legado /api/health (contrato canônico é /api/v1/health)
ENABLE_LEGACY_HEALTH_ALIAS=true
# Origens permitidas para CORS (separadas por vírgula). Em produção, liste origens
# explícitas; NÃO use "*" (é descartado porque allow_credentials=True).
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Autenticação ---
# Com STORAGE=memory, usuários e sessões ficam só na memória do processo (perdidos ao reiniciar).
# AUTH_STORAGE é configuração antiga (só 'memory'); não a defina com STORAGE=postgres.
AUTH_ENABLED=true
# Segredo de assinatura dos access tokens (HS256), mínimo 32 bytes. NUNCA versione o valor real.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Vazio em development/test = segredo aleatório efêmero por instância (tokens caem ao reiniciar).
# Obrigatório em staging/production.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=prazoai-backend
AUTH_JWT_AUDIENCE=prazoai-api
# Validades em segundos (access: 60–3600; sessão/refresh: 3600–2592000; recuperação: 300–86400)
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
# Limites básicos (em memória, por processo)
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_FORGOT_MAX_REQUESTS=3
AUTH_FORGOT_WINDOW_SECONDS=900
# E2: limite por IP do pedido de recuperação (aplicado antes do limite por e-mail)
AUTH_FORGOT_IP_MAX_REQUESTS=10
AUTH_FORGOT_IP_WINDOW_SECONDS=900
# Cadastro e redefinição: limitados por IP antes de qualquer cálculo de Argon2
AUTH_REGISTER_MAX_REQUESTS=10
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_RESET_MAX_REQUESTS=10
AUTH_RESET_WINDOW_SECONDS=900
# Teto de chaves rastreadas por limitador (excedente compartilha um balde de transbordo)
AUTH_RATE_LIMIT_MAX_KEYS=10000
# Sessões simultâneas por usuário (as mais antigas são removidas ao exceder)
AUTH_MAX_SESSIONS_PER_USER=10
# Rotações de refresh por sessão (10–100000). Ao atingir o teto, o próximo refresh encerra
# a sessão (401 session_rotation_limit_reached) e o cliente deve fazer novo login.
AUTH_MAX_REFRESH_ROTATIONS_PER_SESSION=1000

# --- Escritórios, equipe e permissões (Etapa 3) ---
# Vazio = acompanha AUTH_ENABLED. Exige autenticação. Obrigatório (não pode ser false) em staging/production.
OFFICES_ENABLED=
ORG_INVITE_TTL_SECONDS=604800
ORG_INVITE_CREATE_MAX=20
ORG_INVITE_CREATE_WINDOW_SECONDS=3600
ORG_INVITE_LOOKUP_MAX=30
ORG_INVITE_LOOKUP_WINDOW_SECONDS=900
ORG_INVITE_ACCEPT_MAX=10
ORG_INVITE_ACCEPT_WINDOW_SECONDS=900
ORG_JOIN_REQUEST_MAX=10
ORG_JOIN_REQUEST_WINDOW_SECONDS=3600
ORG_MAX_PENDING_INVITES_PER_OFFICE=50
ORG_MAX_PENDING_REQUESTS_PER_OFFICE=200
ORG_MAX_PENDING_REQUESTS_PER_USER=5
ORG_CLOSED_RETENTION_SECONDS=2592000

# --- Prazos (Etapa 4 — EM MEMÓRIA; ativo junto com escritórios) ---
# Fuso IANA da data de referência para urgência (classificação visual, não jurídica).
DEADLINES_TIMEZONE=America/Sao_Paulo
DEADLINES_SOON_DAYS=3
DEADLINES_MAX_PER_SCOPE=10000
DEADLINES_MAX_COMMENTS=1000
DEADLINES_MAX_HISTORY=2000

# --- Intimações e notificações (Etapa 5 — EM MEMÓRIA; sem arquivo nem processamento) ---
INTIMATIONS_MAX_PER_SCOPE=5000
INTIMATIONS_MAX_EVENTS=500
INTIMATIONS_DISCARD_RETENTION_SECONDS=2592000
NOTIFICATIONS_MAX_PER_RECIPIENT=1000
NOTIFICATIONS_READ_RETENTION_SECONDS=7776000

# --- IP do cliente via intermediário confiável (Etapa 6.1 — DESATIVADO por padrão) ---
# Quando definido (mín. 32 bytes), aceita X-PrazoAI-Client-IP SOMENTE com
# X-PrazoAI-Proxy-Secret correto. X-Forwarded-For é sempre ignorado pela aplicação —
# rode o uvicorn com --no-proxy-headers (por padrão ele confia em X-Forwarded-For vindo de 127.0.0.1).
TRUSTED_PROXY_SECRET=

# --- Persistência (P1 fundação, P2 esquema, P3 autenticação) -----------------------------
# STORAGE=memory (padrão): tudo em memória.
# STORAGE=postgres (P4): autenticação E domínio no PostgreSQL; obrigatório em staging/production. Exige
#   DATABASE_URL e o esquema na revisão 0003 (rode `alembic upgrade head` antes; nada é migrado no startup).
#   Em staging/production: DATABASE_URL com ?sslmode=require|verify-ca|verify-full e migrations com
#   PRAZOAI_CONFIRM_MIGRATION_TARGET=<host>:<porta>/<banco>.
STORAGE=memory

# --- Manutenção (P5, só STORAGE=postgres): expurgo de retenção em lotes (doc 20) ---------
# Comando explícito: python -m app.maintenance purge   (códigos de saída no doc 20)
# MAINTENANCE_BATCH_SIZE=200
# MAINTENANCE_MAX_BATCHES_PER_RUN=50
# MAINTENANCE_LOCK_TIMEOUT_MS=200
# MAINTENANCE_STATEMENT_TIMEOUT_MS=5000
# MAINTENANCE_OPPORTUNISTIC_ENABLED=true
# MAINTENANCE_INTERVAL_SECONDS=300
# MAINTENANCE_OPPORTUNISTIC_MAX_BATCHES=4
# Usada só por comandos explícitos (alembic, python -m app.db check). No modo memory a
# aplicação NÃO se conecta, mesmo com esta variável definida. Nunca versione credenciais reais.
# DATABASE_URL=postgresql+psycopg://prazoai:<senha>@localhost:5432/prazoai_dev
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_POOL_TIMEOUT_SECONDS=10
# DATABASE_CONNECT_TIMEOUT_SECONDS=5
# DATABASE_LOCK_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# Testes com PostgreSQL real (banco DESCARTÁVEL prazoai_test*, local, ENVIRONMENT=test):
# TEST_DATABASE_URL=postgresql+psycopg://prazoai:<senha>@localhost:5432/prazoai_test

# --- E-mail transacional (E1/E2, doc 21) — padrão desabilitado: recuperação responde 503 --------
# EMAIL_TRANSPORT=disabled            # disabled | smtp (smtp: só Linux)
# PUBLIC_APP_ORIGIN=http://localhost:3000
# EMAIL_FROM=PrazoAI <nao-responda@exemplo.com>
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURITY=starttls              # starttls | tls | none (none: só loopback + SMTP_ALLOW_INSECURE_LOCAL=true)
# SMTP_ALLOW_INSECURE_LOCAL=false
# SMTP_USERNAME=
# SMTP_PASSWORD=                      # nunca versionar
# SMTP_CA_FILE=
# SMTP_TIMEOUT_SECONDS=10
# SMTP_SEND_DEADLINE_SECONDS=30
# SMTP_TERM_GRACE_SECONDS=1
# SMTP_REAP_TIMEOUT_SECONDS=2
# Capturador local da E3 (somente testes; ver backend/test-infra/mailpit/compose.yaml). Para usar o
# transporte real contra ele: EMAIL_TRANSPORT=smtp, SMTP_HOST=127.0.0.1, SMTP_PORT=1025,
# SMTP_SECURITY=none, SMTP_ALLOW_INSECURE_LOCAL=true (exceção local explícita; ENVIRONMENT=development|test).
# Testes da E3 (pytest): PRAZOAI_TEST_MAILPIT_SMTP=127.0.0.1:1025 PRAZOAI_TEST_MAILPIT_API=http://127.0.0.1:8025
# RecoveryDispatcher (E2): fila em memória, um worker, encerramento com orçamento
# RECOVERY_QUEUE_MAX=100                  # 10–10000; cheia → descarte contado, 202 neutro
# RECOVERY_QUEUE_MAX_WAIT_SECONDS=60      # 10–600; vencido (≥) → descartado antes do banco
# RECOVERY_SHUTDOWN_GRACE_SECONDS=5       # 1–60; orçamento TOTAL do encerramento
# RECOVERY_DB_LOCK_TIMEOUT_MS=1000        # conexão exclusiva do worker (SET LOCAL)
# RECOVERY_DB_STATEMENT_TIMEOUT_MS=3000

# --- PDF das intimações (doc 28) — padrão desligado: envio/consulta de PDF respondem 503 -----------
# FILE_STORAGE=disabled                 # disabled | azure_blob (exige STORAGE=postgres; obrigatório em staging/production)
# AZURE_STORAGE_CONNECTION_STRING=      # SEGREDO do servidor; nunca em NEXT_PUBLIC_*; em staging/production só https
# AZURE_STORAGE_CONTAINER=prazoai-intimacoes   # container PRIVADO (python -m app.files check|create-container)
# FILE_STORAGE_TIMEOUT_SECONDS=20
# FILE_UPLOAD_RESERVATION_SECONDS=3600  # reserva de upload não concluída vira limpeza (python -m app.files cleanup)
# Testes locais com Azurite (emulador; chave pública documentada do devstoreaccount1):
# PRAZOAI_TEST_AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=<chave pública do Azurite>;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# --- Entrar com Google (doc 30) — opcional. Mesmo ID do cliente configurado no BFF (não é segredo).
# O backend só confere o ID token (assinatura RS256 pela JWKS do Google, emissor, público, validade,
# nonce e e-mail verificado); o segredo do cliente fica apenas no BFF.
# GOOGLE_CLIENT_ID=
# GOOGLE_JWKS_URL / GOOGLE_ISSUER: só para testes (recusados em produção).
