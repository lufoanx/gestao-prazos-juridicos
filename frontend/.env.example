# PrazoAI — frontend (Etapa 6.1). Copie para .env.local. NUNCA versione valores reais.
#
# Modo da aplicação (fixado no BUILD): "demo" (dados locais demonstrativos, padrão se vazio)
# ou "integrated" (BFF + FastAPI). Não há troca automática por falha da API.
NEXT_PUBLIC_PRAZOAI_MODE=integrated

# ---- Somente servidor (BFF). Nada abaixo chega ao navegador. ----
# Ambiente da APLICAÇÃO (independe de NODE_ENV; `next start` roda com NODE_ENV=production).
PRAZOAI_APP_ENV=development
# Origem exata do site (verificada em todas as mutações, inclusive login e logout).
PRAZOAI_APP_ORIGIN=http://localhost:3000
# Cookies sem Secure: SÓ com origem HTTP loopback e PRAZOAI_APP_ENV=development|test.
# Em HTTPS, remova esta linha: o cookie vira __Host-prazoai_sid com Secure.
PRAZOAI_COOKIE_INSECURE_LOCAL=true
# Destino FIXO do proxy (FastAPI). Rode o backend com --no-proxy-headers.
PRAZOAI_BACKEND_URL=http://127.0.0.1:8000

# Sessões do BFF (EM MEMÓRIA, um processo Node): capacidade e expiração.
PRAZOAI_BFF_MAX_SESSIONS=1000
PRAZOAI_BFF_SESSION_IDLE_SECONDS=28800
PRAZOAI_BFF_SESSION_MAX_AGE_SECONDS=604800
PRAZOAI_BFF_SWEEP_INTERVAL_SECONDS=60
# Renova o access token quando faltar menos que isto para expirar.
PRAZOAI_ACCESS_REFRESH_SKEW_SECONDS=30
PRAZOAI_BFF_TIMEOUT_MS=10000
PRAZOAI_BFF_MAX_BODY_BYTES=65536

# IP do cliente para os limites de taxa do backend (DESATIVADO por padrão).
# Só habilite atrás de infraestrutura que SOBRESCREVE o cabeçalho abaixo (nunca X-Forwarded-For
# do visitante). O segredo deve ser igual a TRUSTED_PROXY_SECRET do backend (mín. 32 bytes).
# Sem isso, o backend vê o IP do BFF e os limites por IP ficam compartilhados.
PRAZOAI_PROXY_SECRET=
PRAZOAI_TRUSTED_CLIENT_IP_HEADER=
